generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  women
  men
  kids
  accessories
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  brand           String
  category        String
  categoryRecord StoreCategory @relation(fields: [category], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  subCategory     String        @default("")
  price           Decimal       @db.Decimal(12, 2)
  originalPrice   Decimal       @db.Decimal(12, 2)
  stock           Int           @default(0)
  description     String
  material        String        @default("")
  care            String        @default("")
  returnPolicy    String        @default("")
  exchangePolicy  String        @default("")
  shippingInfo    String        @default("")
  warrantyInfo    String        @default("")
  additionalInfo  String        @default("")
  sizes           String[]
  colors          String[]
  image           String
  gallery         String[]
  featured        Boolean       @default(false)
  topTenRank      Int?          @unique
  displayOrder    Int           @default(1000)
  searchPriority  Int           @default(0)
  searchKeywords  String[]      @default([])
  published       Boolean       @default(false)
  seoTitle        String        @default("")
  seoDescription  String        @default("")
  packageContents PackageItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviews         Review[]

  @@index([published, category])
}

model PackageItem {
  id        String  @id @default(cuid())
  name      String
  quantity  Int
  position  Int
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Session {
  token   String   @id
  expires DateTime
  memberId String?
  member TeamMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expires])
}

model StoreCategory {
  id String @id @default(cuid())
  slug String @unique
  label String
  image String @default("")
  subCategories String[] @default([])
  position Int @default(0)
  active Boolean @default(true)
  products Product[]
}

model StoreSettings {
  id String @id @default("main")
  content Json
}

model Banner {
  id String @id @default(cuid())
  title String
  subtitle String @default("")
  eyebrow String @default("")
  image String
  mobileImage String @default("")
  buttonLabel String @default("")
  link String @default("/#catalog")
  destination String @default("link")
  productIds String[] @default([])
  slot String @default("hero")
  position Int @default(0)
  active Boolean @default(false)
  startsAt DateTime?
  endsAt DateTime?
}

enum TeamRole {
  admin
  support
  inventory
}

model TeamMember {
  id String @id @default(cuid())
  name String
  email String @unique
  role TeamRole
  active Boolean @default(true)
  passwordHash String
  sessions Session[]
  tickets SupportTicket[]
}

model SupportTicket {
  id String @id @default(cuid())
  customer String
  email String
  subject String
  message String
  priority String @default("medium")
  status String @default("open")
  assigneeId String?
  assignee TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  replies TicketReply[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketReply {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author String
  text String
  createdAt DateTime @default(now())
}

model SaleRecord {
  id String @id @default(cuid())
  orderRef String @unique
  customerEmail String
  region String
  amount Decimal @db.Decimal(12, 2)
  status String @default("completed")
  soldAt DateTime
  createdAt DateTime @default(now())
}

model LoginAttempt {
  key     String   @id
  count   Int
  expires DateTime

  @@index([expires])
}

model Customer {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  cart Json @default("[]")
  sessions CustomerSession[]
  merges CartMerge[]
  reviews Review[]
  photos ReviewPhoto[]
  checkout Json?
}

model CustomerSession {
  token String @id
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expires DateTime
  @@index([expires])
}

model CartMerge {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token String
  @@unique([customerId, token])
}

model Review {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating Int
  text String
  photos String[]
  createdAt DateTime @default(now())
  @@unique([customerId, productId])
  @@index([productId, createdAt])
}

model ReviewPhoto {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  url String @unique
  createdAt DateTime @default(now())
}
