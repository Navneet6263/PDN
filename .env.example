API_PORT=4000
API_URL=http://127.0.0.1:4000
SITE_URL=http://localhost:3000
ADMIN_EMAIL=admin@terra.local
# Run npm run setup to generate a hashed admin password in .env.
ADMIN_PASSWORD_HASH=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terra_store
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
# DIRECT_URL=postgresql://...
# Cloudinary is the intended photo storage. local is only for offline development.
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set true when deployed behind HTTPS.
COOKIE_SECURE=false
# Online payments. Leave blank for cash on delivery only.
# Razorpay keys: Dashboard → Account & Settings → API Keys. Webhook URL:
# https://YOUR-DOMAIN/api/payments/webhook/razorpay (events: payment.captured, payment.failed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Development only: enables a fake gateway to try the online flow without keys.
PAYMENT_TEST_MODE=false
